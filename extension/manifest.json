{
  "manifest_version": 3,
  "name": "Navo",
  "description": "让 Navo 在你的浏览器里操作你交给它的标签页",
  "version": "0.0.0",
  "permissions": ["debugger", "tabs", "storage", "alarms"],
  "host_permissions": ["ws://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}
