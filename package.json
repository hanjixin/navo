{
  "name": "navo",
  "productName": "Navo",
  "version": "0.1.0",
  "private": true,
  "description": "Navo — 会自己上网干活的桌面 AI Agent（LangChain deepagents + 内置可控浏览器）",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --publish never",
    "postdist": "electron-builder install-app-deps",
    "test:e2e": "electron-vite build && node e2e/tools.mjs && node e2e/agent-mock.mjs && node e2e/layout.mjs && node e2e/discovery.mjs && node e2e/features.mjs && node e2e/langfuse.mjs && node e2e/onboarding.mjs && node e2e/navo-mcp.mjs && node e2e/navo-self.mjs && node e2e/files.mjs && node e2e/mini.mjs && node e2e/memory.mjs",
    "test:agent": "electron-vite build && node e2e/agent.mjs",
    "screenshots": "electron-vite build && node e2e/smoke.mjs",
    "icon": "node e2e/render-icon.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "simple-git-hooks",
    "test:packaged": "node e2e/packaged.mjs",
    "eval:memory": "electron-vite build && node scripts/memory-eval.mjs",
    "eval:agent": "electron-vite build && node scripts/agent-eval.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ],
    "overrides": {
      "better-sqlite3": "^12.11.1"
    }
  },
  "dependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "@napi-rs/canvas": "^1.0.9",
    "better-sqlite3": "^12.11.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@langchain/anthropic": "^1.5.11",
    "@langchain/core": "^1.2.13",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/langgraph-sdk": "^1.12.0",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "^1.6.0",
    "@langfuse/langchain": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "chardet": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deepagents": "^1.14.1",
    "docx": "^9.8.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-xml-parser": "^5.11.1",
    "globals": "^17.12.0",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.2",
    "langchain": "^1.5.14",
    "langsmith": "^0.9.0",
    "lint-staged": "^17.6.0",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "monaco-editor": "^0.57.0",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.1",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "simple-git-hooks": "^2.14.0",
    "smol-toml": "^1.9.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
